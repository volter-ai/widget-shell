#!/bin/sh
# The stylesheet source src/styles.css is the Volter brand's roles (scripts/build-styles.mjs):
# it names a brand(<role>) placeholder, never a literal colour. Lines inside a
# "/* vendor: their own colours */ ... /* end vendor */" block (someone else's colours)
# are exempt. Only lines this commit adds are checked. (Biome skips the source: brand() is
# not CSS until the build resolves it.)
styles=$(git diff --cached --name-only --diff-filter=ACMR -- src/styles.css)
[ -z "$styles" ] || node - $styles <<'JS' || exit 1
const { execFileSync } = require('node:child_process');
const git = (...args) => execFileSync('git', args, { encoding: 'utf8', maxBuffer: 1 << 26 });
const literal = /#[0-9a-fA-F]{3,8}(?![0-9A-Za-z_-])|\brgba?\(|\bhsla?\(/;
let failed = false;
for (const file of process.argv.slice(2)) {
  const added = new Set();
  let line = 0;
  for (const row of git('diff', '--cached', '-U0', '--', file).split('\n')) {
    const hunk = row.match(/^@@ -\S+ \+(\d+)/);
    if (hunk) line = Number(hunk[1]);
    else if (row.startsWith('+') && !row.startsWith('+++')) added.add(line++);
  }
  let vendor = false;
  const bad = [];
  git('show', `:${file}`).split('\n').forEach((text, index) => {
    if (text.includes('vendor: their own colours')) { vendor = true; return; }
    if (text.includes('end vendor')) { vendor = false; return; }
    if (!vendor && added.has(index + 1) && literal.test(text)) bad.push(`  ${index + 1}: ${text.trim().slice(0, 160)}`);
  });
  if (bad.length) {
    failed = true;
    console.error(`pre-commit: literal colour in ${file}; use a token or brand(<role>) (roles: https://brand.volter.ai/tokens)`);
    console.error(bad.join('\n'));
  }
}
process.exit(failed ? 1 : 0);
JS
# Format and lint-fix what is staged, and stage the result: the release's lint then has nothing to refuse.
npx --no-install biome check --write --staged --no-errors-on-unmatched || exit 1
git diff --name-only --cached --diff-filter=ACM -z | xargs -0 git add --
