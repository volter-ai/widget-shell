{
  "name": "@volter-ai-dev/widget-shell",
  "version": "0.3.2",
  "description": "A production-grade overlay runtime for turning responsive web apps into polished widgets and browser extensions.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "packageManager": "npm@11.12.1",
  "license": "MIT",
  "author": "Volter AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volter-ai/widget-shell.git"
  },
  "homepage": "https://github.com/volter-ai/widget-shell#readme",
  "bugs": {
    "url": "https://github.com/volter-ai/widget-shell/issues"
  },
  "keywords": [
    "browser-extension",
    "iframe",
    "overlay",
    "widget",
    "webextension"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js",
      "default": "./dist/frame.js"
    },
    "./lucarne": {
      "types": "./dist/lucarne.d.ts",
      "import": "./dist/lucarne.js",
      "default": "./dist/lucarne.js"
    },
    "./web-extension": {
      "types": "./dist/web-extension.d.ts",
      "import": "./dist/web-extension.js",
      "default": "./dist/web-extension.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "tsup --clean",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run package:check && npm run example:build && npm run size:check",
    "package:check": "publint",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --test --quiet",
    "example:build": "node scripts/build-extension.mjs",
    "size:check": "node scripts/check-size.mjs",
    "prepack": "npm run build && npm run package:check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "esbuild": "^0.28.2",
    "lit": "^3.3.3",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
