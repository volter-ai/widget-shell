{
  "name": "widget-shell-plasmo-example",
  "displayName": "Widget Shell · Plasmo example",
  "description": "A narrowly permissioned Widget Shell integration for Plasmo.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "plasmo build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.3",
    "@types/node": "^26.6.3",
    "plasmo": "^0.90.5",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "tabs/app.html"
        ],
        "matches": [
          "https://example.com/*"
        ]
      }
    ]
  }
}
